# Read by the NestJS app and the TypeORM CLI.
# Copy to .env and adjust: cp .env.example .env

# Port the API listens on (see src/main.ts).
PORT=3000

# Must match the values in the root .env (POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_PORT, POSTGRES_DB).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://sealife:sealife@localhost:5432/sealife"
JWT_SECRET='sealife-jwt-secret'
# REDIS Server
REDIS_URL="redis://localhost:6379"

# e2e tests only (npm run test:e2e). Every table is emptied before each test,
# so the database name must end in _test. Redis databases are numbered and the
# app uses 0; the tests flush theirs, so it must be another number.
TEST_DATABASE_URL="postgresql://sealife:sealife@localhost:5432/sealife_test"
TEST_REDIS_URL="redis://localhost:6379/1"
