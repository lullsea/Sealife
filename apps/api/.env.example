# Read by the NestJS app and Prisma.
# Copy to .env and adjust: cp .env.example .env

# Port the API listens on (see src/main.ts).
PORT=3000

# Must match the values in the root .env (POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_PORT, POSTGRES_DB).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://sealife:sealife@localhost:5432/sealife"
