# Read by Docker Compose (docker-compose.yml) for ${VAR} substitution.
# Copy to .env and adjust: cp .env.example .env
# Note: POSTGRES_* only take effect the FIRST time the volume is created.

POSTGRES_USER=sealife
POSTGRES_PASSWORD=sealife
POSTGRES_DB=sealife

# Host port. Change if 5432 is taken (and update DATABASE_URL in apps/api/.env).
POSTGRES_PORT=5432
